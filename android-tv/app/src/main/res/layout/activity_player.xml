<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- texture_view lets us grab the current frame for "Who's that?" -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="texture_view"
        app:show_buffering="when_playing" />

    <TextView
        android:id="@+id/menu_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/panel_bg"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/hint_menu"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <!-- Companion overlay: answer card on the right, action chips along the bottom -->
    <LinearLayout
        android:id="@+id/answer_card"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="32dp"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/spoiler_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/first_seen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.2"
            android:textSize="19sp" />

        <com.whatdidimiss.tv.KnowledgeBarView
            android:id="@+id/knowledge_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/jump_button"
            style="@style/Chip"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/chips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:scrollbars="none"
        android:visibility="gone">

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button android:id="@+id/chip_who" style="@style/Chip" android:text="@string/chip_who" />
        <Button android:id="@+id/chip_recap" style="@style/Chip" android:text="@string/chip_recap" />
        <Button android:id="@+id/chip_explain" style="@style/Chip" android:text="@string/chip_explain" />
        <Button android:id="@+id/chip_back" style="@style/Chip" android:text="@string/chip_back" />
        <Button android:id="@+id/chip_ask" style="@style/Chip" android:text="@string/chip_ask" />

        <EditText
            android:id="@+id/ask_input"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_bg"
            android:hint="@string/ask_hint"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:visibility="gone" />
      </LinearLayout>
    </HorizontalScrollView>
</FrameLayout>
