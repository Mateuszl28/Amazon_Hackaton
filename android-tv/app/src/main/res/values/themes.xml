<resources>
    <color name="bg">#0E1116</color>
    <color name="panel">#E6161B22</color>
    <color name="accent">#FF9900</color>
    <color name="text">#F2F4F7</color>
    <color name="muted">#9AA4B2</color>

    <style name="Theme.WhatDidIMiss" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
